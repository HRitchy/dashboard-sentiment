# Copier ce fichier en .env.local et renseigner les valeurs.
# .env.local n'est pas commité (voir .gitignore).

# Clé FRED (HY OAS, NFCI). Requise : sans elle, ces deux indicateurs sont
# indisponibles et l'indice composite est calculé sur les indicateurs restants.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
